rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Recipe photos + product images: each user reads/writes only their own folder; webp, max 5MB.
    match /users/{uid}/photos/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType == 'image/webp'));
    }
    // Product pack images, written only by the daily Action.
    match /products/{file} { allow read: if true; }
  }
}
